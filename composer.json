{
    "name": "openeuropa/oe_whitelabel",
    "description": "OpenEuropa Whitelabel theme.",
    "type": "drupal-theme",
    "license": "EUPL-1.2",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "php": ">=8.1",
        "cweagans/composer-patches": "^1.7",
        "drupal/core": "^10 || ^11",
        "drupal/daterange_compact": "^2.0.1",
        "drupal/twig_field_value": "^2.0.2",
        "openeuropa/composer-artifacts": "^1.0.0-alpha1",
        "openeuropa/oe_bootstrap_theme": "dev-EWPP-4655"
    },
    "require-dev": {
        "composer/installers": "^1.11 || ^2.3",
        "drupal/better_exposed_filters": "^6.0.3 || ^7.0",
        "drupal/color_scheme_field": "^1.0@alpha",
        "drupal/composite_reference": "^2.2",
        "drupal/config_devel": "~1.9",
        "drupal/core-composer-scaffold": "^10 || ^11",
        "drupal/core-dev": "^10 || ^11",
        "drupal/description_list_field": "^1.0@alpha",
        "drupal/entity_reference_revisions": "^1.11",
        "drupal/extra_field": "^2.3 || ^3.0@beta",
        "drupal/facets_form": "^1.0.0-alpha6",
        "drupal/field_group": "^3.4",
        "drupal/media_avportal": "dev-3431855-automated-drupal-11",
        "drupal/paragraphs": "^1.17",
        "drupal/remote_stream_wrapper": "dev-d11-compatibility#5e9eb8d290f78f69464ab01ed374439992985811",
        "drupal/search_api": "^1.29",
        "drupal/search_api_autocomplete": "^1.7",
        "drupal/typed_link": "^2.0.1",
        "drush/drush": "^12 || ^13",
        "openeuropa/code-review-drupal": "^1.0.0-alpha",
        "openeuropa/oe_agenda": "dev-EWPP-5408",
        "openeuropa/oe_authentication": "^1.11",
        "openeuropa/oe_contact_forms": "~1.11",
        "openeuropa/oe_content": "dev-EWPP-4642",
        "openeuropa/oe_content_extra": "dev-EWPP-4640",
        "openeuropa/oe_corporate_blocks": "^5.0.0-beta3",
        "openeuropa/oe_link_lists": "^1.0",
        "openeuropa/oe_list_pages": "^1.0.0",
        "openeuropa/oe_multilingual": "^1.14",
        "openeuropa/oe_paragraphs": "dev-EWPP-4643",
        "openeuropa/oe_starter_content": "1.x-dev",
        "openeuropa/oe_subscriptions": "dev-EWPP-5341",
        "openeuropa/task-runner-drupal-project-symlink": "^1.0"
    },
    "conflict": {
        "openeuropa/oe_corporate_blocks": "<4.19"
    },
    "scripts": {
        "post-install-cmd": "./vendor/bin/run drupal:site-setup",
        "post-update-cmd": "./vendor/bin/run drupal:site-setup"
    },
    "repositories": [
        {
            "type": "composer",
            "url": "https://packages.drupal.org/8",
            "exclude": [
                "drupal/media_avportal",
                "drupal/remote_stream_wrapper"
            ]
        },
        {
            "type": "git",
            "url": "https://git.drupalcode.org/issue/media_avportal-3431855.git",
            "reference": "1475bf7a0795f337cd007bc94780dc6041787cf3"
        },
        {
            "type": "package",
            "package": {
                "name": "drupal/remote_stream_wrapper",
                "version": "dev-d11-compatibility",
                "type": "drupal-module",
                "source": {
                    "type": "git",
                    "url": "https://git.drupalcode.org/issue/remote_stream_wrapper-3434168.git",
                    "reference": "5e9eb8d290f78f69464ab01ed374439992985811"
                }
            }
        }
    ],
    "autoload": {
        "psr-4": {
            "Drupal\\oe_whitelabel\\": "./src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Drupal\\Tests\\oe_whitelabel\\": "./tests/src/",
            "Drupal\\Tests\\oe_bootstrap_theme\\": "./build/themes/contrib/oe_bootstrap_theme/tests/src/"
        }
    },
    "extra": {
        "composer-exit-on-patch-failure": true,
        "enable-patching": true,
        "patches-ignore": {
            "openeuropa/oe_content": {
                "drupal/field_group": {
                    "https://www.drupal.org/project/field_group/issues/2787179": "https://www.drupal.org/files/issues/2023-04-07/2787179-highlight-html5-validation-85.patch"
                }
            }
        },
        "artifacts": {
            "openeuropa/oe_bootstrap_theme": {
                "dist": {
                    "url": "https://github.com/{name}/releases/download/0.4655.202504101647/oe_bootstrap_theme-0.4655.202504101647.zip",
                    "type": "zip"
                }
            }
        },
        "drupal-scaffold": {
            "locations": {
                "web-root": "./build"
            }
        },
        "installer-paths": {
            "build/core": [
                "type:drupal-core"
            ],
            "build/profiles/contrib/{$name}": [
                "type:drupal-profile"
            ],
            "build/modules/contrib/{$name}": [
                "type:drupal-module"
            ],
            "build/themes/contrib/{$name}": [
                "type:drupal-theme"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "composer/installers": true,
            "cweagans/composer-patches": true,
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "drupal/core-composer-scaffold": true,
            "openeuropa/composer-artifacts": true,
            "php-http/discovery": false,
            "phpro/grumphp-shim": true,
            "phpstan/extension-installer": true,
            "tbachert/spi": false
        }
    }
}
