{
  "name": "oe_whitelabel",
  "version": "1.0.0",
  "description": "The OpenEuropa Whitelabel theme.",
  "private": true,
  "scripts": {
    "build": "pnpm run build:styles && pnpm run build:copy",
    "build:styles": "cross-env bcl-builder styles",
    "build:copy": "cross-env bcl-builder copy",
    "watch:styles": "chokidar \"./resources/sass/**/*.scss\" -i \"/node_modules/\" -c \"pnpm run build:styles\"",
    "watch": "pnpm run watch:styles",
    "production": "pnpm run build"
  },
  "devDependencies": {
    "@openeuropa/bcl-builder": "1.15.0",
    "chokidar-cli": "^3.0.0",
    "copyfiles": "2.4.1",
    "cross-env": "7.0.3",
    "glob": "7.1.7"
  },
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=22.0.0"
  }
}
