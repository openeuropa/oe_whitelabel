{#
/**
 * @file
 * Theme for the navigation_right search input submit element.
 *
 * @see ./core/modules/system/templates/input.html.twig
 */
#}
{% include 'oe_bootstrap_theme:button' with {
  'variant': 'primary',
  'label': element['#value']|t,
  'icon': 'search',
  'type': 'submit',
  'icon_position': 'before',
  'attributes': attributes
    .addClass([
      'border-start-0',
      'rounded-0',
      'rounded-end',
      'px-3',
    ])
} only %}
{{ children }}
