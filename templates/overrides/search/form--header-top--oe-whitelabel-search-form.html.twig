{#
/**
 * @file
 * Search form template for the header top region.
 */
#}
<div class="search-dropdown dropdown">
  <button type="button" class="btn btn-ghost dropdown-toggle" data-bs-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
    <span class="visually-hidden">{{ 'Toggle search form'|t }}</span>
    {{ pattern('icon', {
      'name': 'search',
      'size': 'fluid',
    }) }}
  </button>
  <div class="dropdown-menu">
    {% include "form.html.twig" with {
      attributes: attributes.addClass('d-flex'),
    } %}
  </div>
</div>
