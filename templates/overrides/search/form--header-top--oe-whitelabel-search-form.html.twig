{#
/**
 * @file
 * Search form template for the header top region.
 */
#}
<div class="search-dropdown dropdown">
  {{ pattern('button', {
    'variant': 'ghost',
    'icon': 'search',
    'attributes': create_attribute({
      'data-bs-toggle': 'dropdown',
      'aria-haspopup': 'true',
      'aria-expanded': 'false',
      'class': [
        'dropdown-toggle',
        'px-2',
      ],
    })
  }) }}
  <div class="dropdown-menu">
    {% include "form.html.twig" with {
      attributes: attributes.addClass('d-flex'),
    } %}
  </div>
</div>
