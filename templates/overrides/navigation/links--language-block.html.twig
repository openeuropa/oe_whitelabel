{% apply spaceless %}

{# Parameters:
  - language
    - link
      - label
      - href
      - target
    - modal
#}

{% set original_label = language.link.name|default('') %}
{% set language_code = language.link.id|default('')|replace({'link_': ''}) %}
{% set display_label = language_code ? language_code|upper : original_label %}
{% set _language_link = {
  label: display_label,
  href: language.link.href|default('#'),
  target: language.link.target|default(language.modal.id|default(''))
} %}
{% set extra_attributes = create_attribute({
  'class': [
    'top-navigation-link',
  ],
  'data-bs-toggle': 'modal',
  'data-bs-target': '#' ~ _language_link.target,
  'aria-label': 'Change language. Current language is @language.'|t({'@language': original_label}),
}) %}

{% set _link_title %}
  <span class="d-none d-xl-inline-block">{{ _language_link.label }}</span>
{% endset %}

{{ pattern('link', {
  label: _link_title,
  path: _language_link.href,
  icon: {
    name: 'globe2',
    size: 'fluid',
  },
  icon_position: 'before',
  remove_icon_spacers: true,
  attributes: extra_attributes
}) }}

{% include '@oe_whitelabel/patterns/modal/modal-language.html.twig' with language.modal only %}

{% endapply %}
