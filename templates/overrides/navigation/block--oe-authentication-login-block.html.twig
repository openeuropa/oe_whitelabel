{% set link_classes = ['top-navigation-link'] %}
{% if logged_in %}
  {% set link_classes = link_classes|merge(['active']) %}
{% endif %}

{% set extra_attributes = create_attribute().addClass(link_classes) %}

{% set title = content['#title']|render %}
{% set icon_name = logged_in ? 'person-check' : 'person' %}
{% set link_title %}
  <span class="d-none d-xl-inline-block">{{ title }}</span>
{% endset %}

