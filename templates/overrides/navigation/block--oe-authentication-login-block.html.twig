{#
/**
 * @file
 * Override for blocks with plugin id = 'oe_authentication_login_block'.
 *
 * @see \Drupal\oe_authentication\Plugin\Block\LoginBlock
 */
#}

{% set extra_attributes = create_attribute().addClass([
  'd-inline-flex',
  'align-items-center',
  'text-dark',
  'gap-2-5',
  'py-1-5',
  'px-2-5',
  'rounded-1',
]) %}

{% set title = content['#title']|render %}
{% set icon_name = logged_in ? 'person-check' : 'person' %}
{% set link_title %}
  <span class="d-none d-xl-inline-block">{{ title }}</span>
{% endset %}

<div class="oe-authentication">
  {{ pattern('link', {
    label: link_title,
    path: content['#url']|render,
    icon: {
      name: icon_name,
      size: 'xs',
    },
    icon_position: 'before',
    standalone: true,
    remove_icon_spacers: true,
    attributes: extra_attributes
  }) }}
</div>
