{#
/**
 * @file
 * Event content banner display.
 */
#}
<div{{attributes}}>
  {% include 'oe_bootstrap_theme:content_banner' with {
    background: 'gray',
    copyright: copyright|default(''),
    title: label,
    content: [
      content.oe_summary,
    ],
    image: image,
    links: links,
    action_bar: content.group_action_bar,
  } only %}
</div>
