{#
/**
 * @file
 * Theme override for the Carousel V2 paragraph.
 */
#}
{% apply spaceless %}
  {% set _slides = [] %}
  {% for _slide in slides %}
    {% if _slide.caption is not empty %}
      {% set _caption %}
        {% block slide_caption %}
          <p>{{ _slide.caption }}</p>
        {% endblock %}
      {% endset %}
      {% set _slide = _slide|merge({caption: _caption}) %}
    {% endif %}
    {% set _slides = _slides|merge([_slide]) %}
  {% endfor %}
{% endapply %}
{% if _slides is not empty %}
  {% include 'oe_bootstrap_theme:carousel_v2' with {
    layout: layout,
    items: _slides,
    attributes: attributes,
  } only %}
{% endif %}
