{#
/**
 * @file
 * Theme override for the Carousel V2 paragraph.
 */
#}
{% apply spaceless %}
  {% set _slides = [] %}
  {% for _slide in slides %}
    {% if _slide.caption is not empty %}
      {% set _caption %}
        {% block slide_caption %}
          <p>{{ _slide.caption }}</p>
        {% endblock %}
      {% endset %}
      {% set _slide = _slide|merge({caption: _caption}) %}
    {% endif %}
    {% set _slides = _slides|merge([_slide]) %}
  {% endfor %}
{% endapply %}
{% if _slides is not empty %}
  {{ pattern('carousel_v2', {items: _slides})|merge({
    '#settings': {
      layout: layout,
      full_bleed: full_bleed,
      attributes: attributes,
    },
  }) }}
{% endif %}
