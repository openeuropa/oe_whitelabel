drupal:
  root: "build"
  base_url: "http://web:8080/build"
  site:
    name: "OpenEuropa Whitelabel theme"
    profile: "minimal"
  database:
    host: "mysql"
    port: "3306"
    name: "drupal"
    user: "root"
    password: ""
  sparql:
    host: "sparql"
    port: "8890"
  post_install:
    # Prepare the instance.
    -
      task: "exec"
      command: |
        ./vendor/bin/drush en -vy \
          config_devel \
          field_ui \
          oe_authentication \
          oe_whitelabel_multilingual \
          oe_whitelabel_contact_forms \
          oe_whitelabel_extra_project \
          oe_whitelabel_helper \
          oe_whitelabel_search \
          oe_whitelabel_list_pages \
          oe_whitelabel_starter_event \
          oe_whitelabel_starter_news \
          oe_whitelabel_starter_person \
          oe_whitelabel_starter_publication \
          oe_whitelabel_paragraphs \
          oe_whitelabel_modal_page \
          toolbar
    - { task: "exec", command: "./vendor/bin/drush recipe \"../recipes/media_image_copyright\"" }
    - { task: "exec", command: "./vendor/bin/drush recipe \"../recipes/media_av_portal_photo_copyright\"" }
    - { task: "exec", command: "./vendor/bin/drush theme:enable oe_whitelabel -y" }
    - { task: "exec", command: "./vendor/bin/drush theme:enable claro -y" }
    - { task: "exec", command: "./vendor/bin/drush config-set system.theme default oe_whitelabel -y" }
    - { task: "exec", command: "./vendor/bin/drush config-set system.theme admin claro -y" }
    - { task: "exec", command: "./vendor/bin/drush config-set node.settings use_admin_theme 1 -y" }
    - { task: "exec", command: "./vendor/bin/drush config-set cas.settings forced_login.enabled 0 -y" }
    - { task: "exec", command: "./vendor/bin/drush config-set system.logging error_level verbose -y" }
    - { task: "exec", command: "./vendor/bin/drush cr" }
  additional_settings: |
    $settings['file_scan_ignore_directories'] = [
      'node_modules',
      'bower_components',
      'vendor',
      'build',
    ];
    $settings['file_private_path'] = 'sites/default/files/private';
    $databases['sparql_default']['default'] = [
      'host' => 'sparql',
      'port' => '8890',
      'namespace' => 'Drupal\sparql_entity_storage\Driver\Database\sparql',
      'driver' => 'sparql',
    ];

selenium:
  host: "http://selenium"
  port: "4444"
  browser: "chrome"

commands:
  drupal:site-setup:
    - { task: "exec", command: "npm install" }
    - { task: "exec", command: "npm run build" }
    - { task: "run", command: "drupal:symlink-project" }
    - { task: "run", command: "drupal:drush-setup" }
    - { task: "run", command: "drupal:settings-setup" }
    - { task: "run", command: "setup:phpunit" }

  setup:phpunit:
    - { task: "process", source: "phpunit.xml.dist", destination: "phpunit.xml" }
    - { task: "remove", file: "build/sites/default/settings.testing.php" }
    - task: "append"
      file: "build/sites/default/settings.testing.php"
      text: |
        <?php

        $settings['extension_discovery_scan_tests'] = TRUE;
        $databases['sparql_default']['default'] = [
          'host' => 'sparql',
          'port' => '8890',
          'namespace' => 'Drupal\sparql_entity_storage\Driver\Database\sparql',
          'driver' => 'sparql',
        ];

  toolkit:code-review:
    # Disable the box requirements check for now.
    # See https://github.com/phpro/grumphp-shim/issues/30.
    - { task: "exec", command: "BOX_REQUIREMENT_CHECKER=0 ./vendor/bin/grumphp run --verbose" }

  toolkit:test-phpunit:
    - { task: "run", command: "toolkit:test-phpunit-batches" }

release:
  drupal_info_files:
    - oe_whitelabel.info.yml
  tasks:
    - { task: "copy", from: "assets", to: "_release_/assets" }

toolkit:
  build:
    custom-code-folder: '${drupal.root}/modules/custom'
  lint:
    eslint:
      options_yaml: 'no-error-on-unmatched-pattern'
      options_js: 'no-error-on-unmatched-pattern'
  test:
    phpunit:
      batch_groups:
        - batch1
  ci:
    PHP:
      - 8.3
    DRUPAL:
      - ~10.5.0
      - ~10.6.0
      - ~11.2.0
      - ~11.3.0
    PUBLISH: false
    BEHAT: false
    PHPUNIT: true
    SELENIUM: true
    SELENIUM_VERSION: 4.1.3-20220405
    SPARQL: true
    SPARQL_VERSION: 1.47.0
